{
  "private": true,
  "name": "vscode-extensions",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Gitpod VS Code extensions monorepo",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@vscode/vsce": "^2.22.0",
    "ovsx": "^0.8.3"
  },
  "scripts": {
    "compile:gitpod-shared": "yarn workspace gitpod-shared compile",
    "build:gitpod-web": "yarn compile:gitpod-shared && yarn workspace gitpod-web vscode:prepublish",
    "build:gitpod-remote": "yarn compile:gitpod-shared && yarn workspace gitpod-remote-ssh vscode:prepublish",
    "build:preview": "yarn workspace @gitpod/portsview-preview build",
    "dev:preview": "yarn workspace @gitpod/portsview-preview dev",
    "hot-reload:gitpod-web": "yarn compile:gitpod-shared && yarn build:gitpod-web && cp -R ./apps/gitpod-web /ide/extensions/gitpod-web"
  }
}
